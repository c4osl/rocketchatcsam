{
    "name": "photodna-scanning",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "unit-test": "tsx --test tests/config/**/*.test.ts tests/lib/**/*.test.ts tests/commands/**/*.test.ts",
        "integration-test": "tsx --test tests/integration/**/*.test.ts",
        "test": "npm run typecheck && npm run lint && npm run format:check && npm run unit-test",
        "prepackage": "node scripts/generate-app-package-json.js",
        "package": "cd app && rc-apps package",
        "predeploy": "node scripts/generate-app-package-json.js",
        "deploy": "cd app && rc-apps deploy",
        "presubmit": "node scripts/generate-app-package-json.js",
        "submit": "cd app && rc-apps submit",
        "postinstall": "patch-package"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@rocket.chat/apps-cli": "^1.14.0",
        "@rocket.chat/apps-engine": "^1.64.1",
        "@rocket.chat/ui-kit": "~1.1.0",
        "@types/node": "^22.10.0",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^10.1.8",
        "patch-package": "^8.0.1",
        "prettier": "^3.9.6",
        "tsx": "^4.23.7",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.15.0"
    },
    "overrides": {
        "@rocket.chat/ui-kit": {
            "typia": "9.7.2"
        }
    }
}
